from fastapi import APIRouter, HTTPException
import os
import tkinter as tk
from tkinter import filedialog

from app.dicom_utils.dicom_preprocessor import import_from_folder

router = APIRouter()

INBOX_DIR = r"D:\proyecto v3\backend\dicom_inbox"

def seleccionar_carpeta_windows():
    """Abre el explorador nativo de Windows para seleccionar una carpeta"""
    root = tk.Tk()
    root.withdraw() # Oculta la ventana principal gris
    root.attributes('-topmost', True) # Fuerza que la ventana aparezca al frente de React
    
    # Abre la ventana de selección
    folder_path = filedialog.askdirectory(title="MI PACS: Seleccione la carpeta del disco externo con los DICOM")
    root.destroy()
    return folder_path

@router.post("/pacientes/import/disco-externo")
def importar_desde_disco():
    try:
        # 1. Python abre la ventana de Windows en tu computadora
        folder_path = seleccionar_carpeta_windows()
        
        # Si el usuario presiona "Cancelar" o cierra la ventana
        if not folder_path:
            return {"status": "cancelled", "mensaje": "Operación cancelada por el usuario."}

        # 2. Python procesa los archivos directamente en el disco duro (¡Ultrarrápido!)
        count = import_from_folder(folder_path, INBOX_DIR)

        return {
            "status": "success",
            "mensaje": f"Se procesaron {count} archivos.",
            "archivos_detectados": count,
            "inbox": INBOX_DIR
        }

    except Exception as e:
        print(f"Error en importación nativa: {e}")
        raise HTTPException(status_code=500, detail=f"Error importando archivos: {e}")